<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The canonical Schematron rules live with the Python judge; this project executes the
             compiled XSLT form of the same files. tools/compile_schematron.py regenerates them,
             and tests on both sides pin behaviour to the .sch source. -->
        <EmbeddedResource Include="..\..\mets-editability\schematron\compiled\*.xsl"
                          LinkBase="Schematron" />
    </ItemGroup>

    <ItemGroup>
        <!-- For MetsIds.IsValidId (the XmlConvert authority) and Constants.MetsCreatorAgent.
             Nothing here depends on the platform beyond that: this project must stay
             extractable alongside a future standalone METS library. -->
        <ProjectReference Include="..\DigitalPreservation.Mets\DigitalPreservation.Mets.csproj" />
    </ItemGroup>

</Project>
