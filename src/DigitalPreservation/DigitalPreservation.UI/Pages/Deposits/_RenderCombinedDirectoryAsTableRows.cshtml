@using DigitalPreservation.Common.Model
@using DigitalPreservation.Common.Model.Transit
@using DigitalPreservation.Common.Model.Transit.Combined
@using DigitalPreservation.Common.Model.Transit.Extensions.Metadata
@using DigitalPreservation.Utils
@using Storage.Repository.Common
@model CombinedDirectoryRecursionWrapper

@{
    CombinedDirectory combinedDirectory = Model.CombinedDirectory;
    var depth = 0;
}

<!--

File is in the METS but not on disk
File is on disk but not in METS
File is in both

"File is in neither" should never happen!
... but could contribute to a files-to-be-deleted?

-->
@if (combinedDirectory.LocalPath.HasText())
{
    var isMetadata = FolderNames.IsMetadata(combinedDirectory.LocalPath);
    var isMetadataRoot = combinedDirectory.LocalPath == FolderNames.Metadata
        || combinedDirectory.LocalPath == $"{FolderNames.BagItData}/{FolderNames.Metadata}";
    depth = combinedDirectory.LocalPath.Split('/').Length;
    string where = combinedDirectory.Whereabouts.ToString().ToLowerInvariant();
    string displayName = combinedDirectory.Name ?? combinedDirectory.LocalPath.GetSlug();

    <tr class="deposit-row @("where-" + where)"
        data-path="@combinedDirectory.LocalPath" data-type="directory" data-whereabouts="@combinedDirectory.Whereabouts" data-metadata="@(isMetadata ? "true" : "false")" data-metadata-root="@(isMetadataRoot ? "true" : "false")"
        style="@(isMetadata && !isMetadataRoot ? "display:none" : null)">
        <td aria-label="select-row">
            @if (Model is { Editable: true, Active: true, LockedByOtherUser: false } && !FolderNames.PathIsKnownFirstLevelDirectory(combinedDirectory.LocalPath) && combinedDirectory.LocalPath != FolderNames.MetadataAdHoc)
            {
                <input class="form-check-input item-selector item-directory" type="checkbox" 
                       value="@combinedDirectory.LocalPath" id="@("is-" + Model.RowCounter.Count)">
                <label class="form-check-label" for="@("is-" + Model.RowCounter.Count++)">@combinedDirectory.Whereabouts</label>
            }
        </td>
        <td class="dep-actions">
            @if (Model is { Editable: true, Active: true, LockedByOtherUser: false } && !isMetadata)
            {
                <button type="button" class="btn btn-sm btn-link link-primary p-0 border-0" data-bs-toggle="modal" data-bs-target="#newFolderModal" aria-label="New folder">
                    <svg class="bi" aria-hidden="true"><use xlink:href="#folder-plus"/></svg>
                </button>
                <button type="button" class="btn btn-sm btn-link link-primary p-0 border-0" data-bs-toggle="modal" data-bs-target="#uploadFileModal" aria-label="Upload file">
                    <svg class="bi" aria-hidden="true"><use xlink:href="#file-earmark-arrow-up"/></svg>
                </button>
            }
        </td>
        <td style="padding-left: @(1.3 * depth)rem">
            <svg class="bi" aria-hidden="true"><use xlink:href="#folder@(where == "deposit" ? "-plus" : "")"/></svg>
            @if (combinedDirectory.LocalPath == "objects" || combinedDirectory.LocalPath.StartsWith("objects/"))
            {
                @await Html.PartialAsync("_AccessAndRights", ((CombinedBase)combinedDirectory, displayName))
            }
            else
            {
                <span title="@combinedDirectory.LocalPath" aria-label="name">@displayName</span>
                @if (isMetadataRoot)
                {
                    var metaTotals = combinedDirectory.GetSizeTotals();
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 me-1 border-0 align-baseline"
                            data-metadata-toggle aria-expanded="false" aria-label="Toggle metadata folder">
                        <svg class="bi" aria-hidden="true"><use xlink:href="#chevron-right"/></svg>
                    </button>
                    <small class="text-body-secondary">@metaTotals.TotalFileCount files in @metaTotals.TotalDirectoryCount folders</small>
                }
            }
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
    </tr>
}
@foreach (var dir in combinedDirectory.Directories)
{
    var wrapper = new CombinedDirectoryRecursionWrapper(
        dir, Model.MetsPath, Model.Editable, Model.Active, Model.LockedByOtherUser, 
        Model.RowCounter);
    @await Html.PartialAsync("_RenderCombinedDirectoryAsTableRows", wrapper)
}
@foreach (var file in combinedDirectory.Files)
{
    var isMetadata = FolderNames.IsMetadata(file.LocalPath!);
    var hasToolOutput = file.FileInDeposit?.Metadata.OfType<ToolOutput>().Any() == true;
    if (file.LocalPath?.GetSlug() == IStorage.DepositFileSystem || FolderNames.BagitFiles.Contains(file.LocalPath?.GetSlug()))
    {
        continue; // this file is hidden
    }
    string where = file.Whereabouts.ToString().ToLowerInvariant();
    bool mismatches = file.MisMatches.Any();
    <tr class="deposit-row @("where-" + where)"
        data-path="@file.LocalPath" data-type="file" data-whereabouts="@file.Whereabouts" data-mismatches="@mismatches" data-metadata="@(isMetadata ? "true" : "false")"
        style="@(isMetadata ? "display:none" : null)">
        <td aria-label="select-row">
            @if (Model is { Editable: true, Active: true, LockedByOtherUser: false } && file.LocalPath != "mets.xml")
            {
                <input class="form-check-input item-selector item-file" type="checkbox" 
                       value="@file.LocalPath" id="@("is-" + Model.RowCounter.Count)">
                @if (mismatches)
                {
                    <label title="@file.MisMatches.First()" class="form-check-label text-danger" for="@("is-" + Model.RowCounter.Count++)">
                        <strong>@file.Whereabouts <svg class="bi" aria-hidden="true"><use xlink:href="#exclamation-triangle"/></svg></strong>
                    </label>
                }
                else
                {
                    <label class="form-check-label" for="@("is-" + Model.RowCounter.Count++)">@file.Whereabouts</label>
                }
            }
        </td>
        <td class="dep-actions">
        </td>
        <td style="padding-left: @(1.3 * (depth + 1))rem">
            <svg class="bi" aria-hidden="true"><use xlink:href="#file-earmark@(where != "both" ? "-plus" : "")"/></svg>
            <span aria-label="name" title="@file.LocalPath">
                @if (file.LocalPath.HasText() && file.LocalPath == Model.MetsPath)
                {
                    <a target="_blank" href="@(Context.Request.Path + "/mets")"><strong>@Model.MetsPath.GetSlug()</strong></a>
                }
                else
                {
                    var displayName = file.GetName() ?? "{{ NO LOCAL PATH }}";
                    if (isMetadata && hasToolOutput)
                    {
                        <a target="_blank" href="@(Context.Request.Path)/tool-output?path=@Uri.EscapeDataString(file.LocalPath!)"><strong>@displayName</strong></a>
                    }
                    else
                    {
                        @await Html.PartialAsync("_AccessAndRights", ((CombinedBase)file, displayName))
                    }
                }
            </span>
        </td>
        <td aria-label="file-links"></td>
        @{
            var contentType = file.GetSingleContentTypeFromMetsAndDeposit();
            var contentTypeDisplay = contentType;
            if (contentType is { Length: > 22 })
            {
                contentTypeDisplay = contentType[..22] + "...";
            }
            var virusMetadata = file.GetVirusMetadata();
        }
        <td aria-label="hash">@file.GetSingleDigest()?[..8]</td>
        <td aria-label="file-size">@StringUtils.FormatFileSize(file.GetSingleSize(), withSpace: true, fallbackIfNull: " - ")</td>
        <td aria-label="content-type">
            @if (contentTypeDisplay != contentType)
            {
                <span title="@contentType">@contentTypeDisplay</span>
            }
            else
            {
                @contentType
            }
        </td>
        <td aria-label="pronom" title="@(file.DepositFileFormatMetadata?.FormatName ?? "(no PRONOM format")">@(file.DepositFileFormatMetadata?.PronomKey ?? "-")</td>

        @if (virusMetadata is { HasVirus: true })
        {
            <td aria-label="td-virus">
                <label title="@virusMetadata.VirusFound" aria-label="virus" class="form-check-label text-danger">
                    <strong>☣</strong>
                </label>
            </td>
        }
        else if (!isMetadata && hasToolOutput)
        {
            <td aria-label="td-tool-output">
                <a target="_blank" href="@(Context.Request.Path)/tool-output?path=@Uri.EscapeDataString(file.LocalPath!)"
                   title="View tool output" aria-label="View tool output" class="text-decoration-none">
                    <svg class="bi" aria-hidden="true"><use xlink:href="#file-earmark-text"/></svg>
                </a>
            </td>
        }
        else
        {
            <td aria-label="td-virus">@virusMetadata?.GetDisplay()</td>
        }

    </tr>
} 
