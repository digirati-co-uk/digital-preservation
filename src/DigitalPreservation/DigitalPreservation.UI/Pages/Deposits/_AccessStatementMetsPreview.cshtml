@*
    The access conditions this node's METS will carry after saving (issue #433), on an installation
    with a statement profile: last in the metadata dialogue, collapsed. Filled by access-statements.js;
    nothing here is saved.
*@
<div class="mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="metsPreviewToggle"
            data-bs-toggle="collapse" data-bs-target="#metsPreview" aria-expanded="false" aria-controls="metsPreview">
        Preview METS access conditions
    </button>
    <div class="collapse mt-2" id="metsPreview">
        <pre id="accessPreviewMets" class="small border rounded bg-body-tertiary p-2 mb-0 access-preview-mets" aria-live="polite"></pre>
    </div>
</div>
