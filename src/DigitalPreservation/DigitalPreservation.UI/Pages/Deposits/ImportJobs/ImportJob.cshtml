@page "/deposits/{depositId}/importjobs/{importJobId}"
@using System.Text.Json
@using DigitalPreservation.Common.Model
@using DigitalPreservation.Common.Model.Import
@using DigitalPreservation.UI.Features
@using DigitalPreservation.UI.Infrastructure
@using DigitalPreservation.Utils
@model ImportJobModel
@{
ViewData["section"] = "deposits";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">@ViewData["Title"]</h1>
</div>

<div>
    <status-message key="@TempDataKeys.Error" variant="danger" dismissible="false" />
</div>

<div class="container-fluid">
    <div class="row align-items-start">
        <div class="col">
            @if (Model.ImportJobId == "diff")
            {
                if (Model.ImportJob == null)
                {
                    <p>No import job to show.</p>
                }
                else
                {
                    if (Model.ItemsWithInvalidSlugs.Any())
                    {
                        <div class="alert alert-danger" role="alert">
                            <p>This import job contains one or more items with invalid slugs:</p>
                            <ul>
                                @foreach (var res in Model.ItemsWithInvalidSlugs)
                                {
                                    <li><span aria-hidden="true">@res.StringIcon</span> @res.Id.GetPathUnderRoot(true)</li>
                                }
                            </ul>
                            <p>Valid characters are <code>a-z A-Z 0-9 ._-%()</code> (not upper case) </p>
                            <p>@Model.ItemsWithInvalidSlugsMessage</p>
                        </div>
                    }
                    if (Model.AddedBinariesWithInvalidContentTypes.Any())
                    {
                        <div class="alert alert-danger" role="alert">
                            <p>This import job contains one or more items with an unidentified content type:</p>
                            <ul>
                                @foreach (var res in Model.AddedBinariesWithInvalidContentTypes)
                                {
                                    <li><span aria-hidden="true">@res.StringIcon</span> @res.Id.GetPathUnderRoot(true)</li>
                                }
                            </ul>
                        </div>
                    }
                    if (Model.RenameRefusalMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <p>@Model.RenameRefusalMessage</p>
                        </div>
                    }

                    @await Html.PartialAsync("_RenderImportJob", Model.ImportJob)

                    if (Model.ItemsWithInvalidSlugs.Any() || Model.AddedBinariesWithInvalidContentTypes.Any() || Model.RenameRefusalMessage != null)
                    {
                        <p>This import job is invalid.</p>
                    }
                    else
                    {
                        <form class="single-submit" method="post" asp-page-handler="ExecuteDiffDirect">
                            @if (Model.ShowNormaliseMetsIds)
                            {
                                @* Only offered alongside the METS ID migration (issue #188 step 3),
                                   under the same feature flag. Renaming identifiers inside a METS
                                   gives the stream's readers nothing to rebuild, so announcing it as
                                   a change would be both wasted work and a misleading history. The
                                   event is still recorded - it just isn't published. *@
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" value="true"
                                           name="suppressActivityStreamEvent" id="suppressActivityStreamEvent">
                                    <label class="form-check-label" for="suppressActivityStreamEvent">
                                        Maintenance only &mdash; keep this version out of the Activity Stream
                                        <span class="text-secondary d-block small">
                                            For changes that alter how the object is recorded rather than what it holds,
                                            such as normalising METS IDs. The event is still recorded, but IIIF and other
                                            consumers will not be told to rebuild.
                                        </span>
                                    </label>
                                </div>
                            }
                            <div class="mb-3">
                                <button type="submit" class="btn btn-sm btn-primary me-2" id="runImport">
                                    <svg class="bi" aria-hidden="true"><use xlink:href="#file-arrow-up"/></svg><span class="ms-2">Run Import (Preserve)</span>
                                </button>
                            </div>
                        </form>
                    }
                
                    <hr/>

                    <div class="form-floating mb-3">
                        <textarea class="form-control" id="importJobJson" readonly>@JsonSerializer.Serialize(Model.ImportJob, new JsonSerializerOptions{WriteIndented = true})</textarea>
                        <label for="importJobJson">Import job (JSON)</label>
                    </div>
                }
            }
            else if (Model.ImportJobId == "custom")
            {
                <!-- UI here - or redirect? --> 
            }
            else
            {
                var jobResult = Model.ImportJobResult!;
                
                <dl class="row job-table" aria-label="Import Job Result Summary">
                    <dt class="col-sm-3">Status</dt>
                    @switch (jobResult.Status)
                    {
                        case ImportJobStates.Waiting:
                            <dd class="col-sm-9 text-bg-warning" data-testid="status"><svg class="bi" aria-hidden="true"><use xlink:href="#hourglass"/></svg> @jobResult.Status</dd>
                            break;
                        case ImportJobStates.Running:
                            <dd class="col-sm-9 text-bg-primary" data-testid="status"><svg class="bi" aria-hidden="true"><use xlink:href="#hourglass"/></svg> @jobResult.Status</dd>
                            break;
                        case ImportJobStates.Completed:
                            <dd class="col-sm-9" data-testid="status">@jobResult.Status</dd>
                            break;
                        case ImportJobStates.CompletedWithErrors:
                            <dd class="col-sm-9 text-bg-danger" data-testid="status">@jobResult.Status</dd>
                            break;
                        default:
                            <dd class="col-sm-9 text-bg-danger" data-testid="status">(unknown status: @jobResult.Status)</dd>
                            break;
                    }
                    @if (jobResult.Errors is { Length: > 0 })
                    {
                        <dt class="col-sm-3">Errors</dt>
                        <dd class="col-sm-9" data-testid="errors">
                            @foreach (var error in jobResult.Errors)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <p>@error.Message</p>
                                </div>
                            }
                        </dd>
                    }
                    <dt class="col-sm-3">Deposit</dt>
                    <dd class="col-sm-9" data-testid="deposit"><a href="/deposits/@jobResult.Deposit!.GetSlug()">@jobResult.Deposit!.GetSlug()</a></dd>
                    <dt class="col-sm-3">Archival Group</dt>
                    <dd class="col-sm-9" data-testid="archival group"><a href="/browse/@jobResult.ArchivalGroup.GetPathUnderRoot()">@jobResult.ArchivalGroup.GetPathUnderRoot()</a></dd>

                    <dt class="col-sm-3">Date Begun</dt>
                    <dd class="col-sm-9" data-testid="date begun">@jobResult.DateBegun.GetDateDisplay()</dd>
                    <dt class="col-sm-3">Date Finished</dt>
                    <dd class="col-sm-9" data-testid="date finished">@jobResult.DateFinished.GetDateDisplay()</dd>
                    
                    <dt class="col-sm-3">Source Version</dt>
                    <dd class="col-sm-9" data-testid="source version">@(jobResult.SourceVersion ?? "(none)")</dd>
                    <dt class="col-sm-3">New Version</dt>
                    <dd class="col-sm-9" data-testid="new version">@(jobResult.NewVersion ?? "...")</dd>
                    
                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9" data-testid="created">@jobResult.Created.GetDateDisplay()</dd>
                    <dt class="col-sm-3">Created By</dt>
                    <dd class="col-sm-9" data-testid="created by">@jobResult.CreatedBy.GetAgentDisplayName()</dd>

                    <dt class="col-sm-3">Import Job</dt>
                    <dd class="col-sm-9" data-testid="import job">@jobResult.ImportJob</dd>
                    <dt class="col-sm-3">Original Import Job</dt>
                    <dd class="col-sm-9" data-testid="original import job">@jobResult.OriginalImportJob</dd>


                    <dt class="col-sm-3">Containers Added</dt>
                    <dd class="col-sm-9">
                        <ul class="list-unstyled" aria-label="containers added">
                            @foreach (var container in jobResult.ContainersAdded)
                            {
                                <li><span aria-hidden="true">📁</span> <a href="/browse/@container.Id.GetPathUnderRoot()">@container.Id.GetPathUnderRoot()</a></li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Binaries Added</dt>
                    <dd class="col-sm-9">
                        <ul class="list-unstyled" aria-label="binaries added">
                            @foreach (var binary in jobResult.BinariesAdded)
                            {
                                <li><span aria-hidden="true">🗎</span> <a href="/browse/@binary.Id.GetPathUnderRoot()">@binary.Id.GetPathUnderRoot()</a></li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Binaries Patched</dt>
                    <dd class="col-sm-9">
                        <ul aria-label="binaries patched">
                            @foreach (var binary in jobResult.BinariesPatched)
                            {
                                <li><span aria-hidden="true">🗎</span> <a href="/browse/@binary.Id.GetPathUnderRoot()">@binary.Id.GetPathUnderRoot()</a></li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Containers Deleted</dt>
                    <dd class="col-sm-9">
                        <ul aria-label="containers deleted">
                            @foreach (var container in jobResult.ContainersDeleted)
                            {
                                <li><svg class="bi" aria-hidden="true"><use xlink:href="#folder"/></svg> @container.Id.GetPathUnderRoot()</li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Binaries Deleted</dt>
                    <dd class="col-sm-9">
                        <ul aria-label="binaries deleted">
                            @foreach (var binary in jobResult.BinariesDeleted)
                            {
                                <li><svg class="bi" aria-hidden="true"><use xlink:href="#file-earmark-text"/></svg> @binary.Id.GetPathUnderRoot()</li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Containers Renamed</dt>
                    <dd class="col-sm-9">
                        <ul aria-label="containers renamed">
                            @foreach (var container in jobResult.ContainersRenamed)
                            {
                            <li><span aria-hidden="true">📁</span> <a href="/browse/@container.Id.GetPathUnderRoot()">@container.Id.GetPathUnderRoot()</a></li>
                            }
                        </ul>
                    </dd>
                    <dt class="col-sm-3">Binaries Renamed</dt>
                    <dd class="col-sm-9">
                        <ul aria-label="binaries renamed">
                            @foreach (var binary in jobResult.BinariesRenamed)
                            {
                            <li> <a href="/browse/@binary.Id.GetPathUnderRoot()">@binary.Id.GetPathUnderRoot()</a></li>
                            }
                        </ul>
                    </dd>
                </dl>
            }
        </div>
    </div>
</div>