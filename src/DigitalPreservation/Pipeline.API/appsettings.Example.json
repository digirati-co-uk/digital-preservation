{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext} {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Storage-AWS": {
    "Profile": "leeds",
    "Region": "eu-west-1"
  },
  "AWS": {
    "Profile": "leeds",
    "Region": "eu-west-1"
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "DisableAuth": "true",
    "UseLocalHostedServiceForPipeline": "true",
    "NormaliseMetsIdsOnWrite": "false",
    "_comment": "AllowPipelineForCallerBuckets (issue #410): copy a deposit in a caller's own bucket to StorageOptions:ScratchCopyPath and run the pipeline on the copy. Switch on together with the Preservation API's flag of the same name.",
    "AllowPipelineForCallerBuckets": "false"
  },
  "ApiKeyOptions": {
    "ApiKey": "API Key",
    "ApiHeaderName": "X-API-KEY"
  },
  "StorageOptions": {
    "_comment": "ScratchCopyPath (issue #410): where a deposit in a caller's own bucket is copied for a job, and deleted after it. ScratchCopyMaxBytes: the largest deposit that will be copied.",
    "FileMountPath": "C:\\Test_1\\MountTest",
    "ScratchCopyPath": "C:\\Test_1\\Scratch",
    "ScratchCopyMaxBytes": 2147483648
  },
  "PipelineToolOptions": {
    "PathToBrunnhilde": "\\\\Python\\\\Python314\\Lib\\\\site-packages\\\\brunnhilde.py",
    "PathToPython": "\\Programs\\Python\\Python314\\python.exe",
    "DirectorySeparator": "\\",
    "ObjectsFolder": "objects",
    "PipelineMetadataFolders": "metadata/brunnhilde,metadata/exif,metadata/virus-definition"
  },
  "PipelineOptions": {
    "PipelineJobTopicArn": "arn:-of-pipeline-job-runner-topic",
    "PipelineJobQueue": "pipeline-job-runner-queue"
  },
  "ConnectionStrings": {
    "PreservationApiBaseUrl": "https://localhost:7228/"
  },
  "Preservation": {
    "Root": "https://localhost:7228"
  },
  "_comment": "AzureAd: Leeds. TokenProvider: auth token provider.",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "enter tenant id",
    "ClientId": "enter client id",
    "Audience": "enter audience"
  },
  "TokenProvider": {
    "TenantId": "enter tenant id",
    "ClientSecret": "enter client secret",
    "ClientId": "enter client id",
    "ResourceUri": ""
  }
}
