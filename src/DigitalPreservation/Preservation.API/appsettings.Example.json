{
  "ConnectionStrings": {
    "Postgres": "postgres conn string here"
  },
  "RunMigrations": true,
  "Storage": {
    "Root": "https://localhost:7000"
  },
  "Storage-AWS": {
    "Profile": "leeds",
    "Region": "eu-west-1"
  },
  "AwsStorage": {
    "DefaultWorkingBucket": "dev-deposits-s3bucket-name",
    "S3HealthCheckKey": "checks/test.json"
  },
  "ResourceMutator": {
    "Storage": "https://localhost:7000",
    "Preservation": "https://localhost:7228"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "enter tenant id here",
    "ClientId": "enter client id here ",
    // RFC-0001 Phase 0: accept both audiences during transition. NOTE: a top-level "Audiences"
    // key is NOT supported by Microsoft.Identity.Web's AddMicrosoftIdentityWebApi(section) path
    // (it binds to nothing, and with "Audience" absent the API falls back to ClientId-derived
    // defaults, rejecting all current callers). Binding through TokenValidationParameters is the
    // form that works. Real values come from secrets.
    "TokenValidationParameters": {
      "ValidAudiences": [
        "api://a616cf42...", // current audience (the shared UI registration)
        "api://84c62880..."  // the API's own App ID URI (the migration target)
      ]
    },
    "ClientSecret": "enter client id here"
  },
  // RFC-0001 Phase 0 allow-list of known machine callers, keyed by the signed azp/appid claim.
  // Empty => every machine caller falls back to the X-Client-Identity header (current behaviour).
  // Example entry (depositBucket is modeled but not consumed until the bucket-routing phase):
  //   "22222222-2222-2222-2222-222222222222": { "name": "goobi", "depositBucket": "leeds-goobi-deposits" }
  "KnownClients": {},
  //Auth Token Provider
  "TokenProvider": {
    "TenantId": "enter a tenant id",
    "ClientSecret": "enter ui client secret",
    "ClientId": "enter ui client id"
  },
  "FeatureFlags": {
    "DisableAuth": "false",
    "EnableIiifMediaEndpoints": "false",
    "EnableMetsIdNormalisation": "false",
    "NormaliseMetsIdsOnWrite": "false"
  },
  "PipelineOptions": {
    "PipelineJobTopicArn": "arn:aws:-of-the-pipeline-job-runner-topic"
  },
  "AccessConditions": [
    { "Value": "dlip-open",       "Label": "Open" },
    { "Value": "dlip-2-restricted", "Label": "Restricted" },
    { "Value": "dlip-3-protected",  "Label": "Protected" },
    { "Value": "dlip-4-closed",     "Label": "Closed" },
    { "Value": "dlip-unassessed",   "Label": "Unassessed" }
  ],
  "RangeTypes": ["Collection", "Item"]
}
