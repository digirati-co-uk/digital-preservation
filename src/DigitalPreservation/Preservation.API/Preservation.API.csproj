<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.1" />
      <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.1" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.16" />
      <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.16" />
      <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
      <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
      <PackageReference Include="iiif-net" Version="0.4.6" />
      <PackageReference Include="LinqKit.Core" Version="1.3.0" />
      <PackageReference Include="MediatR" Version="12.5.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
      <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
      <PackageReference Include="Microsoft.Identity.Web.GraphServiceClient" Version="4.16.0" />
      <PackageReference Include="NetVips" Version="3.2.0" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
      <PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    </ItemGroup>

    <PropertyGroup>
      <!-- libvips (used by the media server's image service) is a native dependency, so it must match the
           runtime being *targeted*, not the machine doing the build. A RID-specific build (dotnet publish -r ...)
           names its target; a RID-agnostic one, as Dockerfile.PreservationApi uses, can only be for the build host. -->
      <VipsRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</VipsRuntimeIdentifier>
      <VipsRuntimeIdentifier Condition="'$(VipsRuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</VipsRuntimeIdentifier>
      <VipsRuntimeIdentifier Condition="'$(VipsRuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</VipsRuntimeIdentifier>
      <VipsRuntimeIdentifier Condition="'$(VipsRuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</VipsRuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
      <!-- Only the matching RID is pulled in - each NetVips.Native.* package is ~25MB. The NetVips wrapper is MIT;
           the native libvips bundle is LGPL-3.0-or-later, loaded dynamically. -->
      <PackageReference Include="NetVips.Native.$(VipsRuntimeIdentifier)" Version="8.18.7"
                        Condition="'$(VipsRuntimeIdentifier)' != ''" />
    </ItemGroup>

    <Target Name="WarnIfNoLibVips" BeforeTargets="Build" Condition="'$(VipsRuntimeIdentifier)' == ''">
      <Warning Text="No NetVips.Native package matches this build - the media server's image service will fail at runtime. Add a VipsRuntimeIdentifier mapping for '$(RuntimeIdentifier)'." />
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\DigitalPreservation.Workspace\DigitalPreservation.Workspace.csproj" />
      <ProjectReference Include="..\LeedsDlipServices\LeedsDlipServices.csproj" />
      <ProjectReference Include="..\Storage.Client\Storage.Client.csproj" />
    </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Preservation.API.Tests" />
  </ItemGroup>

</Project>
