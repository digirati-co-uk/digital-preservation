{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext} {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage-AWS": {
    "Region": "eu-west-1"
  },
  "AwsStorage": {
    "DefaultWorkingBucket": "dev-deposits",
    "S3HealthCheckKey": "checks/test.json"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "FeatureFlags": {
    "DisableAuth": "false",
    "EnableIiifMediaEndpoints": "false",
    "EnableMetsIdNormalisation": "false",
    "NormaliseMetsIdsOnWrite": "false",
    "UseLocalPipelineDelivery": "false"
  },
  "IdentityService": {
    "Root": "https://id.library.leeds.ac.uk",
    "TimeoutMs": 5000,
    "ApiKeyHeader": "X-API-KEY"
  },
  "AccessConditionProfile": {
    "_comment": "Issue #433, Leeds (development). The two-axis form: Protected Access Level x copyright status -> Access Tier, the master matrix verbatim. The tier's Type, the PA values, the copyright status Type and the rights statements permitted under each status are ASSUMPTIONS pending Leeds' answers on #433. Explained in docs/internals/access-condition-profile.md; the standard, non-derived form is the AccessConditions list in appsettings.Example.json.",
    "AllowMultipleRestrictions": false,
    "RestrictionAxis": {
      "Label": "Protected Access Level",
      "Values": [
        { "Value": "PA1", "Label": "Level 1" },
        { "Value": "PA2", "Label": "Level 2" },
        { "Value": "PA3", "Label": "Level 3" },
        { "Value": "PA4", "Label": "Level 4" },
        { "Value": "PA-unassessed", "Label": "Unassessed" }
      ]
    },
    "CategoryAxis": {
      "Label": "Copyright status",
      "Type": "copyright status",
      "Values": [
        { "Value": "public-domain", "Label": "Out of Copyright (Public Domain / CC0)",
          "RightsStatements": [ "NoC-US", "NoC-NC", "NoC-OKLR", "NoC-CR", "NKC", "CC0" ] },
        { "Value": "low-risk", "Label": "In Copyright: Assessed (Low Risk)",
          "RightsStatements": [ "InC", "InC-EDU", "InC-NC", "InC-RUU", "InC-OW-EU", "CC-BY", "CC-BY-SA", "CC-BY-ND", "CC-BY-NC", "CC-BY-NC-SA", "CC-BY-NC-ND" ] },
        { "Value": "restrictions-apply", "Label": "In Copyright (restrictions apply)",
          "RightsStatements": [ "InC", "InC-OW-EU", "InC-RUU", "NoC-OKLR", "NoC-CR" ] },
        { "Value": "medium-risk", "Label": "In Copyright (medium risk)",
          "RightsStatements": [ "InC", "InC-OW-EU", "InC-RUU" ] },
        { "Value": "unassessed", "Label": "In Copyright (Unassessed)",
          "RightsStatements": [ "CNE", "UND" ] },
        { "Value": "high-risk", "Label": "In Copyright (High Risk)",
          "RightsStatements": [ "InC", "InC-OW-EU", "InC-RUU" ] }
      ]
    },
    "RightsAxis": {
      "Label": "Copyright Statement"
    },
    "Derived": [
      {
        "Type": "tier",
        "Label": "Access Tier",
        "Values": [
          { "Value": "0", "Label": "Tier 0 - Open" },
          { "Value": "1", "Label": "Tier 1 - Open" },
          { "Value": "2", "Label": "Tier 2 - Restricted" },
          { "Value": "3", "Label": "Tier 3 - Protected" },
          { "Value": "4", "Label": "Tier 4 - Closed" },
          { "Value": "5", "Label": "Tier 5 - Unassessed" }
        ],
        "Matrix": {
          "PA1": { "public-domain": "0", "low-risk": "1", "restrictions-apply": "2", "medium-risk": "2", "unassessed": "2", "high-risk": "3", "__none__": "2", "*": "3" },
          "PA2": { "*": "3" },
          "PA3": { "*": "3" },
          "PA4": { "*": "4" },
          "PA-unassessed": { "*": "5" },
          "__none__": { "*": "5" },
          "*": { "*": "5" }
        }
      }
    ]
  },
  "RangeTypes": ["Collection", "Item"]
}
