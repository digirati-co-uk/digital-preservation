{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext} {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage-AWS": {
    "Region": "eu-west-1"
  },
  "AwsStorage": {
    "DefaultWorkingBucket": "dev-deposits",
    "S3HealthCheckKey": "checks/test.json"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "FeatureFlags": {
    "DisableAuth": "false",
    "EnableIiifMediaEndpoints": "false",
    "EnableMetsIdNormalisation": "false",
    "NormaliseMetsIdsOnWrite": "false",
    "UseLocalPipelineDelivery": "false"
  },
  "IdentityService": {
    "Root": "https://id.library.leeds.ac.uk",
    "TimeoutMs": 5000,
    "ApiKeyHeader": "X-API-KEY"
  },
  "AccessConditions": [
    { "Value": "Open", "Label": "Open" },
    { "Value": "Restricted", "Label": "Restricted" },
    { "Value": "Closed", "Label": "Closed" }
  ],
  "_comment_AccessConditions": "The standard model: a restriction from this list and a rights statement, both chosen. Leeds' environments name their profile document in appsettings.{DEV,TEST,PROD}.json, which replaces this list (docs/internals/access-condition-profile.md).",
  "RangeTypes": ["Collection", "Item"]
}
