{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "HealthChecks": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext} {CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage-AWS": {
    "Region": "eu-west-1"
  },
  "AwsStorage": {
    "DefaultWorkingBucket": "dev-deposits",
    "S3HealthCheckKey": "checks/test.json"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/"
  },
  "FeatureFlags": {
    "DisableAuth": "false",
    "EnableIiifMediaEndpoints": "false",
    "EnableMetsIdNormalisation": "false",
    "NormaliseMetsIdsOnWrite": "false",
    "UseLocalPipelineDelivery": "false"
  },
  "IdentityService": {
    "Root": "https://id.library.leeds.ac.uk",
    "TimeoutMs": 5000,
    "ApiKeyHeader": "X-API-KEY"
  },
  "AccessConditionProfile": {
    "_comment": "Issue #433. Leeds: Protected Access Level x rights-statement group -> Access Tier 0-5 (the agreed matrix). The tier's Type and the PA values are ASSUMPTIONS pending Leeds' Goobi METS example and confirmed vocabulary.",
    "AllowMultipleRestrictions": false,
    "RestrictionAxis": {
      "Label": "Protected Access Level",
      "Values": [
        { "Value": "PA1", "Label": "Level 1" },
        { "Value": "PA2", "Label": "Level 2" },
        { "Value": "PA3", "Label": "Level 3" },
        { "Value": "PA4", "Label": "Level 4" },
        { "Value": "PA-unassessed", "Label": "Unassessed" }
      ]
    },
    "RightsAxis": {
      "Label": "Copyright Statement",
      "Groups": [
        {
          "Key": "public-domain",
          "Label": "Out of copyright (public domain / CC0)",
          "Members": [ "NoC-US", "NoC-NC", "NoC-OKLR", "NoC-CR", "NKC", "CC0", "CC-BY", "CC-BY-SA" ]
        },
        {
          "Key": "low-risk",
          "Label": "In copyright: assessed, low risk / permission given",
          "Members": [ "InC-EDU", "InC-NC", "CC-BY-NC", "CC-BY-ND", "CC-BY-NC-SA", "CC-BY-NC-ND" ]
        },
        {
          "Key": "restricted",
          "Label": "In copyright (restrictions apply)",
          "Members": [ "InC", "InC-OW-EU", "InC-RUU" ]
        },
        {
          "Key": "unassessed",
          "Label": "Copyright unassessed",
          "Members": [ "CNE", "UND", "__none__", "*" ]
        }
      ]
    },
    "Derived": [
      {
        "Type": "tier",
        "Label": "Access Tier",
        "Values": [
          { "Value": "0", "Label": "Tier 0 - Open" },
          { "Value": "1", "Label": "Tier 1 - Open" },
          { "Value": "2", "Label": "Tier 2 - Restricted" },
          { "Value": "3", "Label": "Tier 3 - Protected" },
          { "Value": "4", "Label": "Tier 4 - Closed" },
          { "Value": "5", "Label": "Tier 5 - Unassessed" }
        ],
        "Matrix": {
          "PA1": { "public-domain": "0", "low-risk": "1", "restricted": "2", "unassessed": "2" },
          "PA2": { "*": "3" },
          "PA3": { "*": "3" },
          "PA4": { "*": "4" },
          "PA-unassessed": { "*": "5" },
          "__none__": { "*": "5" }
        }
      }
    ]
  },
  "RangeTypes": ["Collection", "Item"]
}
