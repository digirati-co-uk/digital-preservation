# Preservation API to drive. Point this at development first: it holds far more affected
# Archival Groups than production does, and none of them matter.
PRESERVATION_API=https://dlip-pres-preservation.example.ac.uk

# OAuth2 client credentials, as iiif-builder uses. Not needed when DISABLE_AUTH is true.
PRESERVATION_CLIENT_ID=
PRESERVATION_CLIENT_SECRET=
PRESERVATION_TENANT_ID=
DISABLE_AUTH=false

# Sent as X-Client-Identity, and recorded as each deposit's createdBy and preservedBy - which is
# how a migration version is told apart from one a person made.
CLIENT_IDENTITY=mets-id-migration
SUBMISSION_TEXT=METS ID normalisation (issue #188 step 3)

# One ledger per deployment - it is bound to the PRESERVATION_API it was first opened against and
# refuses to be opened against another. Dev and prod share Archival Group paths, and the ledger is
# keyed on those, so a shared file would let one system's verdict stand for the other.
LEDGER_PATH=ledger-dev.sqlite

# Optional. Only used to turn the candidate list into links someone can follow, for when the list
# turns out to be short enough to work through by hand in the UI.
UI_BASE_URL=

# Pacing. Every migration is an import job; leave the platform room for the people using it.
PAUSE_SECONDS=1.0

# The same for the survey, which only reads, and so runs flat out unless told otherwise. Reading
# one Archival Group is still several Fedora requests. Worth setting against production; --pause
# overrides it for a single run.
SURVEY_PAUSE_SECONDS=0
DEPOSIT_PAGE_SIZE=100
IMPORT_JOB_TIMEOUT_SECONDS=600
IMPORT_JOB_POLL_SECONDS=5
HTTP_TIMEOUT_SECONDS=120

# Keep migrations out of the published Activity Stream. Set false only to watch one travel the
# normal path end to end.
SUPPRESS_ACTIVITY_STREAM_EVENT=true
